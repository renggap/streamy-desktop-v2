{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/refs/heads/dev/crates/tauri-cli/schema.json",
  "productName": "Streamy Desktop",
  "version": "2.0.0",
  "identifier": "com.streamy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Streamy Desktop",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../crates/streamy-lame/lame_notice.txt"
    ],
    "windows": {
      "bundleVCRuntime": true,
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwQUE1NjJCNzU3OENDNkMKUldSc3pIaDFLMWFxUU15a01wOExaekVNdVEwSEdyK1laWk5tTXFqVkh2SFlOL2JuQkpxZDdlYkYK",
      "endpoints": [
        "https://github.com/renggap/streamy-desktop-v2/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
